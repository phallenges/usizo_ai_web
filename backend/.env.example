# Required in production. Generate with a cryptographically secure password generator.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
ENVIRONMENT=production
# Comma-separated public app/admin origins. Do not use * in production.
CORS_ALLOWED_ORIGINS=https://app.example.com
# PostgreSQL is required in production. Keep DATABASE_PATH for local SQLite only.
SEED_DEMO_DATA=false
DATABASE_URL=postgresql://usizoai:replace-password@localhost:5432/usizoai
DATABASE_PATH=./data/usizo.db
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=5
# Admin bearer token for the operations dashboard.
ADMIN_TOKEN=replace-with-a-random-admin-token
# SMTP settings used to email approved Plus activation tokens.
# Note: Render's free instance type blocks outbound SMTP ports 25, 465 and 587.
# Use the HTTPS provider settings below on the free plan instead.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=UsizoAI <no-reply@example.com>
# HTTPS email delivery (preferred). Transports are auto-selected in this
# order: mailjet, brevo, sendgrid, smtp — the first fully configured one wins.
# Set EMAIL_TRANSPORT to pin one (mailjet|brevo|sendgrid|smtp); a pin that is
# unknown or incomplete reports "not configured" instead of falling back.
# EMAIL_FROM defaults to SMTP_FROM and must be a verified sender at the provider.
EMAIL_FROM=UsizoAI <no-reply@example.com>
# MAILJET_API_KEY=mailjet-api-key
# MAILJET_SECRET_KEY=mailjet-secret-key
# BREVO_API_KEY=brevo-api-key-from-app.brevo.com
# SENDGRID_API_KEY=sendgrid-api-key
# EMAIL_TRANSPORT=mailjet
# EMAIL_TIMEOUT_SECONDS=15
# Optional Android release and version-check settings.
# GITHUB_TOKEN=github_pat_used_to_raise_github_api_rate_limits
# APP_LATEST_VERSION=1.2.0  # static fallback when GitHub is unreachable
# APP_MINIMUM_VERSION=1.0.0
# APP_VERSION_CACHE_SECONDS=600
