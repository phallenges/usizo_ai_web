# Required in production. Generate with a cryptographically secure password generator.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
ENVIRONMENT=production
# Comma-separated public app/admin origins. Do not use * in production.
CORS_ALLOWED_ORIGINS=https://app.example.com
# PostgreSQL is required in production. Keep DATABASE_PATH for local SQLite only.
SEED_DEMO_DATA=false
DATABASE_URL=postgresql://usizoai:replace-password@localhost:5432/usizoai
DATABASE_PATH=./data/usizo.db
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=5
# Admin bearer token for the operations dashboard.
ADMIN_TOKEN=replace-with-a-random-admin-token
# Server-side OpenAI-compatible Chat Completions provider. Never ship these
# values in the Flutter app. LLM_BASE_URL may be a provider root, end in /v1,
# or be the full /v1/chat/completions URL.
LLM_BASE_URL=https://api.openai.com
LLM_API_KEY=replace-with-provider-key
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
RATE_LIMIT_CHAT_PER_MINUTE=12
